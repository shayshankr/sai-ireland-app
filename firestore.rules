rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isSignedIn() && userDoc().role == 'super_admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Users can create their own doc; cannot self-promote role
      allow create: if isOwner(uid)
        && !('role' in request.resource.data && request.resource.data.role != 'member');
      // Owners and admins may edit a profile, but only a super_admin may
      // change the `role` field itself — otherwise any admin could
      // promote themselves (or anyone else) to super_admin.
      allow update: if isSuperAdmin()
        || ((isOwner(uid) || isAdmin())
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isSuperAdmin();
    }

    // ── Events ─────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();
      // Any member can create their own event; only admins can edit/delete
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Polls ──────────────────────────────────────────────────────────────
    match /polls/{pollId} {
      allow read: if isSignedIn();
      // Any member can create a poll; only admins can close or delete
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();

      match /votes/{uid} {
        allow read: if isSignedIn();
        // One vote per user — enforced by document path == uid + existence check.
        // Also require the parent poll to still be open, otherwise anyone could
        // vote via a direct Firestore write after an admin closes the poll
        // (the "no more votes will be accepted" guarantee shown in the app).
        allow create: if isOwner(uid)
          && get(/databases/$(database)/documents/polls/$(pollId)).data.isOpen == true
          && !exists(/databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid));
        allow update, delete: if false;
      }
    }

    // ── Join Requests ──────────────────────────────────────────────────────
    match /joinRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Contact Messages ───────────────────────────────────────────────────
    match /messages/{messageId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Announcements ──────────────────────────────────────────────────────
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── News (written by Cloud Function / admin only) ──────────────────────
    match /news/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Gallery ────────────────────────────────────────────────────────────
    match /gallery/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Seva Opportunities ─────────────────────────────────────────────────
    match /seva/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /rsvps/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
      }
    }

    // ── Bhajan Library ─────────────────────────────────────────────────────
    match /bhajans/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Daily Quotes ───────────────────────────────────────────────────────
    match /quotes/{date} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── WhatsApp invite link (admin-only for security) ─────────────────────
    match /config/whatsappInvite {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Per-user notification preferences ─────────────────────────────────
    match /notificationPrefs/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}

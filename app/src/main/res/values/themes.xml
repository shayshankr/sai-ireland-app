<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme — no action bar; Compose handles all chrome -->
    <style name="Theme.SaiIreland" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme (Android 12+ SplashScreen API) -->
    <style name="Theme.SaiIreland.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_om</item>
        <item name="postSplashScreenTheme">@style/Theme.SaiIreland</item>
    </style>
</resources>
